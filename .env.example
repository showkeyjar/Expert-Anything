# ExpertAnything 运行时配置（复制为 .env 并填入你的值）
# 本文件只是示例，真实配置请放在同目录的 .env 中（已被 config.py 自动加载）。

# 必填：OpenAI 兼容接口的 API Key。不填则系统以「确定性降级」方式运行，
# 抽取出的知识模型只有文本结构索引、概念定义与关系为空。
EXPERTANYTHING_LLM_API_KEY=sk-your-key-here

# 可选：自定义 OpenAI 兼容端点（默认官方 OpenAI）。
# 例如 DeepSeek: https://api.deepseek.com/v1
# 例如本地 Ollama: http://localhost:11434/v1
EXPERTANYTHING_LLM_BASE_URL=https://api.openai.com/v1

# 可选：模型名（默认 gpt-4o-mini）。本地模型可填 llama3 / qwen2.5 等。
EXPERTANYTHING_LLM_MODEL=gpt-4o-mini

# 可选：自定义数据存储目录（默认 <项目>/data）
# EXPERTANYTHING_DATA_DIR=D:/codes/Expert-Anything/data
